# ==============================================================================
# MS Gestor de Información - Environment Variables
# ==============================================================================
# Este archivo sirve como plantilla base y funcional para desarrollo local y
# local con Docker Compose.
# Para producción, copia este archivo a .env y define credenciales seguras.
# ==============================================================================

# Entorno de ejecución: development | production | test
APP_ENV=development
APP_NAME="MS Gestor de Información"

# ------------------------------------------------------------------------------
# Backend (Go)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
GIN_MODE=debug
# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# En Docker Compose interno el host es 'postgres'.
# Si ejecutas el backend directamente en el host (fuera de Docker), usa 'localhost'.
DB_HOST=postgres
DB_PORT=5432
DB_USER=gestor_user
DB_PASSWORD=gestor_password
DB_NAME=gestor_info_db
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# Frontend (Vue 3 + Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# URL del backend accesible desde el navegador del cliente
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Integraciones de Microservicios (Línea de Productos de Software)
# ------------------------------------------------------------------------------
# MS Gestor de Info depende de MS Digitalización
MS_DIGITALIZACION_URL=http://localhost:8081
# MS Reportes depende de MS Gestor de Info
MS_REPORTES_URL=http://localhost:8082
