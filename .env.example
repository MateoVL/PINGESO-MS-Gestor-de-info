# ==============================================================================
# MS Gestor de Información (Servicio N=2) - Plantilla de Variables de Entorno
# ==============================================================================
# Todas las variables se listan con valores 'replace-with-*' según AGENTS.md sección 5.
# Copia este archivo a .env y define los valores específicos antes de ejecutar.
# El archivo .env NUNCA debe commitearse.
# ==============================================================================

# Variables Obligatorias del Backend (AGENTS.md sección 5)
API_PORT=replace-with-api-port-8080
API_ENV=replace-with-api-env-dev-test-or-prod
DATABASE_URL=replace-with-database-url
AUTH_JWKS_URL=replace-with-auth-jwks-url
FRONTEND_URL=replace-with-frontend-url
TZ=replace-with-tz-america-santiago

# Integraciones de Microservicios dependientes (<SERVICIO>_URL)
DIGITALIZACION_URL=replace-with-digitalizacion-url
IDENTIDAD_URL=replace-with-identidad-url

# Configuración de Aplicación y Logs
APP_NAME=replace-with-app-name
LOG_LEVEL=replace-with-log-level
CORS_ALLOWED_ORIGINS=replace-with-cors-allowed-origins

# Base de datos PostgreSQL para Docker Compose
POSTGRES_DB=replace-with-postgres-db
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_PORT=replace-with-postgres-port

# Puertos locales en el host para desarrollo (Servicio 2: 5120 web y 5121 api)
FRONTEND_PORT=replace-with-frontend-port-5120
BACKEND_PORT=replace-with-backend-port-5121
BACKEND_URL=replace-with-backend-url

# Metadatos del Servicio
SERVICE_ROLE=replace-with-service-role
SERVICE_DEPENDS_ON=replace-with-service-depends-on
SERVICE_CONSUMERS=replace-with-service-consumers
SERVICE_CAPABILITIES=replace-with-service-capabilities
