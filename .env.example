# ==============================================================================
# MS Gestor de Información - Environment Variables
# ==============================================================================
# Este archivo sirve como plantilla base y funcional para desarrollo local y
# local con Docker Compose.
# Para producción, copia este archivo a .env y define credenciales seguras.
# ==============================================================================

# Entorno de ejecución: development | production | test
APP_ENV=development
# En API_ENV=dev el servicio expone documentación interactiva en /api/docs
API_ENV=dev
APP_NAME="MS Gestor de Información"

# ------------------------------------------------------------------------------
# Backend (Go 1.26.5 + Huma v2.34.1)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
LOG_LEVEL=info
# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL 17.11)
# ------------------------------------------------------------------------------
# POSTGRES_URI se usa al ejecutar Go directamente en el host.
POSTGRES_URI=postgres://127.0.0.1:5432/gestor_info_db?sslmode=disable
POSTGRES_PORT=5432
POSTGRES_DB=gestor_info_db
POSTGRES_USER=gestor_user
POSTGRES_PASSWORD=dev-gestor-password

# ------------------------------------------------------------------------------
# Frontend (React 19.2.8 + Vite 8.1.5 + TypeScript 6.0.3)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Opcional. Por defecto usa http://localhost:8080 en desarrollo y proxy /api en producción.
# VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Integraciones de Microservicios (Línea de Productos de Software)
# ------------------------------------------------------------------------------
# MS Gestor de Info depende de MS Digitalización
MS_DIGITALIZACION_URL=http://localhost:8081
# MS Reportes depende de MS Gestor de Info
MS_REPORTES_URL=http://localhost:8082

SERVICE_ROLE="Gestor de Información"
SERVICE_DEPENDS_ON="Extractor de Datos OCR"
SERVICE_CONSUMERS="Motor de Reportes"
SERVICE_CAPABILITIES="Carga de información,Limpieza y validación de datos,Inserción masiva de datos"
