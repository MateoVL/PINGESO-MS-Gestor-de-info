# ==============================================================================
# MS Gestor de Información - Environment Variables
# ==============================================================================
# Este archivo sirve como plantilla base y funcional para desarrollo local y
# local con Docker Compose.
# Para producción, copia este archivo a .env y define credenciales seguras.
# ==============================================================================

# Entorno de ejecución: development | production | test
APP_ENV=development
APP_NAME="MS Gestor de Información"

# ------------------------------------------------------------------------------
# Backend (Go)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
GIN_MODE=debug
LOG_LEVEL=info
# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Base de Datos (MongoDB)
# ------------------------------------------------------------------------------
# MONGO_URI se usa al ejecutar Go directamente en el host.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_PORT=27017
MONGO_DATABASE=gestor_info_db
MONGO_USER=gestor_user
MONGO_PASSWORD=dev-gestor-password
MONGO_ROOT_USER=gestor_admin
MONGO_ROOT_PASSWORD=dev-admin-password

# ------------------------------------------------------------------------------
# Frontend (Vue 3 + Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Opcional. Por defecto, producción usa /api en el mismo origen vía Nginx.
# VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Integraciones de Microservicios (Línea de Productos de Software)
# ------------------------------------------------------------------------------
# MS Gestor de Info depende de MS Digitalización
MS_DIGITALIZACION_URL=http://localhost:8081
# MS Reportes depende de MS Gestor de Info
MS_REPORTES_URL=http://localhost:8082

SERVICE_ROLE="Gestor de Información"
SERVICE_DEPENDS_ON="Extractor de Datos OCR"
SERVICE_CONSUMERS="Motor de Reportes"
SERVICE_CAPABILITIES="Carga de información,Limpieza y validación de datos,Inserción masiva de datos"
